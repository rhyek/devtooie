{
  // Program used by `pnpm test:types` (vitest --typecheck). Same as tsconfig.json, minus the
  // three spec files that already fail typecheck on main with unrelated fixture errors — so a
  // real type error anywhere else still fails the run instead of being blanket-ignored.
  "extends": "./tsconfig.json",
  "exclude": [
    "src/process-manager.spec.ts",
    "src/internal-logger.spec.ts",
    "src/log-formatter.spec.ts"
  ]
}
