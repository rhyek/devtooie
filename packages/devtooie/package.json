{
  "name": "devtooie",
  "version": "0.0.0",
  "description": "Dependency-aware CLI for running a monorepo's local dev processes.",
  "author": "Carlos González <carlos.rgn@gmail.com>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhyek/devtooie.git",
    "directory": "packages/devtooie"
  },
  "keywords": [
    "monorepo",
    "dev",
    "cli",
    "orchestration",
    "dependencies",
    "tui",
    "ink"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "devtooie": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "docs",
    "postinstall.js"
  ],
  "scripts": {
    "postinstall": "node ./postinstall.js",
    "palette": "node scripts/palette-preview.ts",
    "build": "rm -rf dist && tsc -p ./tsconfig.build.json && chmod +x dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@dotenvx/primitives": "^3.3.1",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "execa": "^10.2.1",
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "slice-ansi": "^9.0.1",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "typescript": ">=5.4.0"
  }
}
