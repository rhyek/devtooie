{
  "name": "devtooie-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "build": "pnpm --filter devtooie build",
    "lint": "oxlint --disable-nested-config && oxfmt --check --disable-nested-config",
    "palette": "pnpm --filter devtooie palette",
    "test:types": "vitest --typecheck.only --run",
    "format": "oxfmt --disable-nested-config",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "typecheck": "tsc -p packages/devtooie/tsconfig.json --noEmit"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
