# devtooie example — port block 01 of ~/Dev/reserved_port_ranges.txt (21050–21099).
# The dev reverse proxy's own port: http://localhost:21050 (and http://<subdomain>.localhost:21050)
# is the whole example, routed to each package (and the mail catcher) by its `proxy` in
# devtooie.config.ts.
DEV_REVERSE_PROXY_PORT=21050

NODE_OPTIONS="$NODE_OPTIONS --disable-warning=ExperimentalWarning"

# Read by devtooie.config.ts's `port` callback for the backend, which devtooie then injects
# into the process as PORT.
BACKEND_PORT=3001

# The Postgres service in docker-compose.yaml, which devtooie's `infra` brings up. These are read
# twice: by Compose, to configure the container and publish its port, and by the app, through
# DATABASE_URI — built here by interpolation so the pieces are stated once.
DB_HOST=localhost
DB_PORT=21051
DB_USER=example
DB_PASSWORD=example
DB_NAME=example
DATABASE_URI="postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# The Mailpit mail catcher in docker-compose.yaml: its web UI is routed by the dev reverse proxy
# at http://mail.localhost:21050 (MAIL_UI_PORT is the `port` devtooie.config.ts gives it), and it
# accepts mail over SMTP on MAIL_SMTP_PORT.
MAIL_UI_PORT=21054
MAIL_SMTP_PORT=21055
