# Loaded by `devtooie --mode test` instead of .env.development (modes are exclusive).
# Values shared by every mode belong in .env / .env.local.
BACKEND_PORT=3011
# Test mode's own dev reverse proxy port, so a test session can run next to a development one.
DEV_REVERSE_PROXY_PORT=21053
GREETING=hello from test mode

# Test mode's own Postgres: a different port, and (because the mode is part of the Compose
# project name) a different container and volume from development's — the two run side by side.
DB_HOST=localhost
DB_PORT=21052
DB_USER=example
DB_PASSWORD=example
DB_NAME=example
DATABASE_URI="postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Test mode's own Mailpit, next to development's.
MAIL_UI_PORT=21056
MAIL_SMTP_PORT=21057
