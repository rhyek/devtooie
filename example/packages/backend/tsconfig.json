{
  "extends": "../../tsconfig.common.json",
  "compilerOptions": {
    "types": ["node"],
    // @example/db's source is type-checked as part of this program, and its files import each
    // other by their real `.ts` name (see its tsconfig).
    "allowImportingTsExtensions": true
  },
  "include": ["src"],
  // devtooie reads these project references (no separate tsconfig.build.json) to build
  // @example/isomorphic before this package runs. @example/db is NOT referenced here — it's a
  // source-only lib wired by the pnpm `workspace:*` link, not a compiled project.
  "references": [{ "path": "../isomorphic" }]
}
